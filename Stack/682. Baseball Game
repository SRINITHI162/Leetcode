class Solution {
    public int calPoints(String[] operations) {
        Stack<Integer>s=new Stack<>();
        for(String op:operations)
        {
            if(op.equals("C"))
            {
                s.pop();
            }
            else if(op.equals("D"))
            {
                int p=s.peek()*2;
                s.push(p);
            }
            else if(op.equals("+"))
            {
                int a=s.pop();
                int b=s.peek();
                int c=a+b;
                s.push(a);
                s.push(c);
            }
            else
            {
                s.push(Integer.parseInt(op));
            }
        }
        int sum=0;
        for(int st:s)
        {
            sum=sum+st;
        }
        return sum;

    }
}
