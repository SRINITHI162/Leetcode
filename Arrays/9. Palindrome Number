class Solution {
    public boolean isPalindrome(int x) {
        if(x<0)
        {
            return false;
        }
        int digits=0;
        int num=x;
        while(x!=0)
        {
            int digit=x%10;
            digits=(digits*10)+digit;
            x=x/10;
        }
        if(digits==num)
        {
            return true;
        }
        else
        {
            return false;
        }
        
    }
}
