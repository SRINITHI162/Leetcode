class Solution {
    public int maximumGap(int[] nums) {
        int sub=0;
        int max=Integer.MIN_VALUE;
        if(nums.length<2)
        {
            return 0;
        }
        Arrays.sort(nums);
        for(int i=0;i<nums.length-1;i++)
        {
            sub=nums[i+1]-nums[i];
            if(max<sub)
            {
                max=sub;
            }
        }
        return max;
        
    }
}
