class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int max=0;
        for(int i=0;i<candies.length;i++)
        {
            if(candies[i]>max)
            {
                max=candies[i];
            }
        }
        List<Boolean> a=new ArrayList<Boolean>();
        for(int c:candies)
        {
            if(c+extraCandies>=max)
            {
                a.add(true);
            }
            else
            {
                a.add(false);
            }
        }
        return a;
    }
}
