class Solution {
    public int strStr(String haystack, String needle) {
        int a=haystack.length;
        int b=needle.length;
        for(int i=0;i<a;i++)
        {
            for(int j=0;j<b;j++)
            {
                if(haystack[i]==needle[j])
                {
                    j++;
                }
                else
                {
                    j=0;
                }
            }
        }
        
    }
}
